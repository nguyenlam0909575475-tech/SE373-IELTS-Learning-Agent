# ==============================================================================
# SE373 IELTS Learning Agent Environment Configuration (.env.example)
# Note: Keep actual secret keys in .env (which is strictly git-ignored).
# ==============================================================================

# Central Switch Flag (Member 5):
# "true" = Run in fast, deterministic Mock Agent mode (offline / grading UI test)
# "false" = Run in Live Agent mode (requires LLM API keys below)
USE_MOCK_AGENT="true"

# LLM & Model Settings
OPENAI_API_KEY="your-api-key-here"
SE373_MODEL="gpt-4o-mini"

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="your-langsmith-key-here"
LANGCHAIN_PROJECT="SE373-IELTS-Agent"

# Server Host and Port
HOST="0.0.0.0"
PORT="8000"
DEBUG="false"
