# ==============================================================================
# SE373 IELTS Learning Agent Environment Configuration (.env.example)
# Note: Keep actual secret keys in .env (which is strictly git-ignored).
# ==============================================================================

# Central Switch Flag (Member 5):
# The web uses the live agent. Offline mock evaluation is available only through evals/run.py --mock.
USE_MOCK_AGENT="false"

# LLM & Model Settings
OPENAI_API_KEY="your-api-key-here"
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_MODEL="openai/gpt-oss-20b"
OPENAI_RESPONSE_FORMAT="json_object"

# Optional Gemini provider; leave unused keys empty
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY="your-langsmith-key-here"
LANGCHAIN_PROJECT="SE373-IELTS-Agent"

# Server Host and Port
HOST="0.0.0.0"
PORT="8000"
DEBUG="false"
